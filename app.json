{
  "expo": {
    "name": "BetTok",
    "icon": "./assets/icon2.png",
    "slug": "bettok",
    "version": "1.0.0",
    "scheme": "bettok",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.spark",
      "newArchEnabled": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon2.png",
        "backgroundColor": "#121212"
      },
      "package": "com.yourname.spark",
      "newArchEnabled": true
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*"],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fef05820-3a76-4588-9632-c7b4b013093f"
      }
    }
  }
}